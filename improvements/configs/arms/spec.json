{
  "layers": {
    "final": {"moderator_final_only": true},
    "batch": {"batch_agents_in_round": true},
    "gpu_faiss": {"faiss_gpu": true, "gpu_memory_utilization": 0.45},
    "novelty": {"skip_duplicate_query": true, "zero_novelty_exit": true},
    "r1": {"response_rounds": 1},
    "r2": {"response_rounds": 2},
    "tokens128": {"agent_max_tokens": 128},
    "budgets": {"agent_max_tokens": 128, "moderator_max_tokens": 32, "concise_agents": true},
    "anchored": {"evidence_store": "anchored", "evidence_delimiters": true},
    "layout": {"context_token_budget": 2500, "prompt_layout": "evidence_first"},
    "logprob": {"judge_scoring": "logprob", "judge_order_balance": true},
    "schema": {"opponent_action_schema": true},
    "apc": {"enable_prefix_caching": true},
    "q1": {"question_batch_size": 1},
    "q2": {"question_batch_size": 2, "refill_window": true},
    "q4": {"question_batch_size": 4, "refill_window": true},
    "q8": {"question_batch_size": 8, "refill_window": true},
    "q16": {"question_batch_size": 16, "refill_window": true},
    "q32": {"question_batch_size": 32, "refill_window": true},
    "unified": {"answer_extractor": "unified"},
    "audit": {"rewrite_novelty_audit": true},
    "refined": {"judge_sees_refined_query": true},
    "lazy": {"lazy_query_opponent": true, "escalation_tau": 0.5},
    "grounded": {"opponent_mode": "grounded", "verdict_sequestration": true},
    "vote": {"aggregator": "vote"}
  },
  "jobs": {
    "E01": {
      "A": {"layers": []},
      "B": {"layers": ["final"]},
      "C": {"layers": ["final", "batch"]},
      "D": {"layers": ["final", "batch", "gpu_faiss"]},
      "E": {"layers": ["final", "batch", "threads"], "note": "fallback if D fails"}
    },
    "E02a": {
      "A": {"layers": ["P"]},
      "B": {"layers": ["P", "novelty"]},
      "C": {"layers": ["P", "r1"]},
      "D": {"layers": ["P", "r1", "budgets"]},
      "opt-r2": {"layers": ["P", "r2"], "note": "optional, only if the time budget allows"},
      "opt-tokens128": {"layers": ["P", "tokens128"], "note": "optional, only if the time budget allows"}
    },
    "E02b": {
      "A": {"layers": ["P"]},
      "B": {"layers": ["P", "anchored"]},
      "C": {"layers": ["P", "anchored", "layout"]},
      "D": {"layers": ["P", "logprob"]},
      "E": {"layers": ["P", "anchored", "logprob", "schema"]},
      "F": {"layers": ["P", "anchored", "layout", "apc"], "note": "run twice on the E00 60-question subset"}
    },
    "E03": {
      "B1": {"layers": ["P", "q1"]},
      "B2": {"layers": ["P", "q2"]},
      "B4": {"layers": ["P", "q4"]},
      "B8": {"layers": ["P", "q8"]},
      "B16": {"layers": ["P", "q16"]},
      "B32": {"layers": ["P", "q32"]}
    },
    "E04": {
      "e5": {"layers": ["P"]},
      "hybrid": {"layers": ["P", "best_hybrid"]}
    },
    "E05": {
      "naive": {"layers": ["P"], "arms": ["naive"], "note": "route arm"},
      "drag": {"layers": ["P"], "arms": ["drag"], "note": "route arm; refine-only and decompose need J20/J22"}
    },
    "PC": {
      "full-stack": {"layers": ["unified", "final", "batch", "q4", "novelty", "r1", "budgets",
                                 "anchored", "audit", "layout", "logprob", "schema", "refined",
                                 "lazy", "grounded", "vote"],
                     "note": "every PC-runnable improvement at once; rehearsal and integration only"},
      "full-stack-generative": {"layers": ["unified", "final", "batch", "q4", "novelty", "r1",
                                            "budgets", "anchored", "audit", "layout", "schema",
                                            "refined", "lazy", "grounded", "vote"],
                                "note": "the full stack with the generative Judge"},
      "grounded-vote": {"layers": ["unified", "grounded", "vote"],
                        "note": "J18 answer stage with the vote aggregator"}
    }
  }
}
